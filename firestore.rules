rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Farmer Profiles Collection
    match /farmers/{farmerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Transporter Profiles Collection
    match /transporters/{transporterId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Transport Requests Collection
    match /transport_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // Transporter Responses / Quotes Collection
    match /transporter_responses/{responseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
